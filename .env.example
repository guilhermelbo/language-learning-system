# ============================================================
# LingoAI — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- LLM (standard text pipeline) ---
LLM_PROVIDER=openai_compatible
LLM_MODEL_NAME=Qwen3.5-35B-A3B-UD-IQ3_S.gguf
LLM_BASE_URL=http://host.docker.internal:8080/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_ENABLE_THINKING=False

# --- STT & TTS (standard voice pipeline) ---
STT_API_URL=http://stt:8001
TTS_API_URL=http://tts:8002
PIPER_MODEL_PATH=pt_BR-faber-medium.onnx

# --- Voice Channel (speech-to-speech tutoring) ---
# O servidor de voz roda FORA do projeto, da mesma forma que o LLM via llamacpp.
# Suba o servidor externamente (ver ai_services/omni/README.md), depois aponte
# VOICE_API_URL para ele e habilite com VOICE_ENABLED=true.
#
# Exemplo — servidor de voz na mesma máquina host:
#   VOICE_API_URL=http://host.docker.internal:8003
#
VOICE_ENABLED=false
VOICE_PROVIDER=generic
VOICE_API_URL=http://host.docker.internal:8003
VOICE_TIMEOUT_SECONDS=30
VOICE_MAX_AUDIO_SECONDS=60
